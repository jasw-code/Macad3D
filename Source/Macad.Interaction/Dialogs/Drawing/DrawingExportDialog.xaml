<mmp:Dialog x:Class="Macad.Interaction.Dialogs.DrawingExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mmp="clr-namespace:Macad.Presentation;assembly=Macad.Presentation"
        xmlns:panels="clr-namespace:Macad.Interaction.Panels"
        mc:Ignorable="d" 
        Style="{StaticResource {x:Type mmp:Dialog}}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="{Binding ExportPanel.Header}"
        ResizeMode="CanResizeWithGrip" 
        ShowInTaskbar="False" 
        SizeToContent="Manual"
        Width="800"
        Height="500"
        MinWidth="600"
        MinHeight="400"
        AutomationProperties.AutomationId="ExportDrawingDialog">

    <mmp:Dialog.Footer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Cancel" 
                    IsCancel="True" 
                    Style="{StaticResource Macad.Styles.Button.DialogFooter}" 
                    AutomationProperties.AutomationId="Cancel" />
            <Button Content="Export" 
                    IsDefault="True" 
                    Style="{StaticResource Macad.Styles.Button.DialogFooter}"
                    Command="{Binding ExportCommand}"
                    AutomationProperties.AutomationId="Ok" />
        </StackPanel>
    </mmp:Dialog.Footer>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="Auto" MaxWidth="260" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="{StaticResource Macad.Brushes.Panel.Header.Border}"
                BorderThickness="1">
            <panels:DrawingPreviewPanel Drawing="{Binding Drawing}" />
        </Border>

        <ContentPresenter Grid.Column="2"
                          Content="{Binding ExportPanel}" />
    </Grid>
</mmp:Dialog>
