<UserControl x:Class="Macad.Interaction.Panels.DrawingPreviewPanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mmp="clr-namespace:Macad.Presentation;assembly=Macad.Presentation"
                 mc:Ignorable="d" 
                 d:DesignHeight="300" d:DesignWidth="300"
                 Background="{StaticResource Macad.Brushes.Drawing.Background}">

    <Grid>
        <TextBlock Text="Empty Drawing"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{StaticResource Macad.Styles.TextBlock.PanelHintText}"
                   Visibility="{Binding Source, Converter={mmp:NotNullToInvisibleHiddenConverter}, ElementName=Image}"/>

        <Viewbox Stretch="Uniform"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Margin="5">
            <Image x:Name="Image"
                   Stretch="None" />
        </Viewbox>
    </Grid>
</UserControl>
